{
  "name": "react-native-hotswap",
  "version": "0.1.0",
  "description": "Hot-swap the native side of your React Native app. Kotlin today, C++ and Swift next. Safest with Nitro.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "bin": {
    "hotswap": "./cli/bin/hotswap.js"
  },
  "files": [
    "src",
    "lib",
    "cli",
    "android",
    "ios",
    "metro.cjs",
    "*.podspec",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun run typecheck && bob build",
    "clean": "git clean -dfX"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "hot reload",
    "hot reloading",
    "fast refresh",
    "native module",
    "kotlin",
    "swift",
    "jvmti",
    "developer tools",
    "android",
    "ios"
  ],
  "repository": "https://github.com/Salve-Software/react-native-hotswap.git",
  "author": "Salve Software (https://github.com/Salve-Software)",
  "license": "MIT",
  "bugs": "https://github.com/Salve-Software/react-native-hotswap/issues",
  "homepage": "https://github.com/Salve-Software/react-native-hotswap#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "react-native": "0.76.5",
    "react-native-builder-bob": "^0.33.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
