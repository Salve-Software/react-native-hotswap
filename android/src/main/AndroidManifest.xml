<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!-- attachJvmtiAgent needs a real file path, and with extractNativeLibs=false the
       agent stays compressed inside the APK with nothing on disk to point at. -->
  <application
    android:extractNativeLibs="true"
    tools:replace="android:extractNativeLibs">

    <provider
      android:name="com.hotswap.HotswapStartup"
      android:authorities="${applicationId}.hotswap"
      android:exported="false"
      android:initOrder="1000" />
  </application>
</manifest>
